# Server
PORT=3000
ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fluxa?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Stellar
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Stellar Core RPC endpoint. Reported by GET /health as the "stellar_core"
# dependency; when unset, /health reports that dependency as down.
STELLAR_CORE_URL=
# USDC issuer on Stellar testnet
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Key management — must be exactly 64 hex characters (32 bytes)
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=replace_with_64_char_hex_string

# Treasury wallet funds newly created accounts (testnet: leave empty, use Friendbot)
TREASURY_SECRET_KEY=

# Platform fee collection wallet (Stellar public key)
PLATFORM_FEE_WALLET_PUBLIC_KEY=

# Migrations path (relative to binary working directory)
MIGRATIONS_PATH=db/migrations

# Alerting webhook URL (Slack or generic webhook for reconciliation alerts)
# Leave empty to disable alerting
ALERT_WEBHOOK_URL=

# Balance drift threshold, in USD, that triggers a reconciliation alert.
# A drift of exactly this amount does not alert; only amounts above it do.
# Leave empty to default to 1.
RECONCILIATION_DRIFT_THRESHOLD_USD=1

# Distributed tracing (OpenTelemetry). Disabled by default: with OTEL_ENABLED
# unset, no spans are recorded or exported and the request path is unchanged.
OTEL_ENABLED=false
# OTLP/HTTP collector base URL. Spans are POSTed to <endpoint>/v1/traces.
OTEL_EXPORTER_ENDPOINT=http://localhost:4318
# Reported as the service name on every span.
OTEL_SERVICE_NAME=fluxa

# Admin API key for /v1/admin routes (optional, or use sk_admin_ prefix)
ADMIN_API_KEY=
