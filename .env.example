# Server
PORT=3000
ENV=development
# Set false in a secondary region; the API remains active but no worker is started.
WORKER_ENABLED=true

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fluxa?sslmode=disable
# Optional read replica; reads fall back to DATABASE_URL when unavailable
REPLICA_DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379
# Optional Redis Sentinel configuration. When set, Sentinel takes precedence over REDIS_URL.
REDIS_SENTINEL_MASTER_NAME=
REDIS_SENTINEL_ADDRS=
REDIS_SENTINEL_PASSWORD=

# Stellar
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# USDC issuer on Stellar testnet
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Key management — must be exactly 64 hex characters (32 bytes)
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=replace_with_64_char_hex_string

# Treasury wallet funds newly created accounts (testnet: leave empty, use Friendbot)
TREASURY_SECRET_KEY=

# Platform fee collection wallet (Stellar public key)
PLATFORM_FEE_WALLET_PUBLIC_KEY=

# Migrations path (relative to binary working directory)
MIGRATIONS_PATH=db/migrations

# Alerting webhook URL (Slack or generic webhook for reconciliation alerts)
# Leave empty to disable alerting
ALERT_WEBHOOK_URL=

# Admin API key for /v1/admin routes (optional, or use sk_admin_ prefix)
ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# Compliance screening (issue #69)
# ---------------------------------------------------------------------------
# Master switch. When false, no screener is attached and transfers are not
# screened. Screening otherwise fails CLOSED: if the sanctions list cannot be
# loaded, transfers are held for review rather than cleared.
COMPLIANCE_ENABLED=true

# OFAC SDN list. Operator-configured, never user-supplied. Refreshed daily by
# cmd/worker; every process reloads from the sanctions_entities table.
OFAC_SDN_URL=https://sanctionslistservice.ofac.treas.gov/api/download/sdn.xml

# Structuring rule: flags when the running total to one destination sits
# within 5% below the next multiple of this unit (3 x 999 flags, 3 x 1000
# does not).
COMPLIANCE_STRUCTURING_UNIT=1000

# Velocity rule: more than this many transfers from one org inside the window
# holds the next one.
COMPLIANCE_VELOCITY_MAX_TRANSFERS=10
COMPLIANCE_VELOCITY_WINDOW_MINUTES=10

# Round-trip rule: holds when the source already received funds from this
# destination inside the window.
COMPLIANCE_ROUND_TRIP_WINDOW_MINUTES=60

# Maximum edit distance at which a destination name is treated as a probable
# sanctions match. Name matches hold; only exact address matches block.
COMPLIANCE_FUZZY_THRESHOLD=2

# How often each process reloads the sanctions set from the database. This is
# what carries the worker's daily refresh into the API process's memory.
COMPLIANCE_RELOAD_MINUTES=15
